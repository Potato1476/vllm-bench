    {
      "type": "timeseries",
      "title": "GPU slots: allocatable vs requested (time-slicing)",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "The Kubernetes view of the GPU, which DCGM cannot give you. Time-slicing advertises one physical L4 as 2 schedulable nvidia.com/gpu units, so 'allocatable' here is a number the NVIDIA device plugin invented -- it is not 2 cards. When requested reaches allocatable the scheduler stops placing GPU pods, even though the card may be far from saturated. That is the failure this panel exists to catch: pods Pending on a GPU that still has headroom, or the reverse, two models contending for one card.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(kube_node_status_allocatable{resource=\"nvidia_com_gpu\"})",
          "legendFormat": "slots allocatable",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum(kube_pod_container_resource_requests{resource=\"nvidia_com_gpu\"})",
          "legendFormat": "slots requested",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
