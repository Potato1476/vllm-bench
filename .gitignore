# --- Terraform ---
# State holds resource IDs and can hold plaintext values; it belongs in S3, never in git.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl.bak
crash.log
crash.*.log
*.tfplan
*.tfplan.*

# tfvars carry per-account values (bucket names, owner tags). Only the example is tracked.
*.tfvars
*.tfvars.json
!*.tfvars.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.venv-embed/
venv/

# Dense vectors are derived data: ~3 MB per 800 chunks today, and the corpus is the
# thing under version control. Rebuild with `make dense-build`, or pull the built index
# from S3 beside the corpus it was built from -- the model id is recorded next to the
# vectors so a mismatched pair fails loudly instead of returning plausible nonsense.
data/index/
# ...but keep the directory itself, so the guardrail image can COPY it whether or
# not the index has been built. Without a tracked file here the Docker build fails
# on a clean clone, which is every CI run.
!data/index/.gitkeep
.ruff_cache/
.pytest_cache/

# --- Benchmark datasets ---
# The generated JSONL is ~64 MB and regenerable byte-for-byte from make_datasets.py
# with the same --version and --model. S3 is where it lives; git keeps the manifest,
# which carries the checksums that make a result traceable to its input.
bench/datasets/*.jsonl
!bench/datasets/manifest-*.json

# --- Benchmark output ---
# Raw runs are large and regenerable; only curated files under reports/ get committed.
results/

# The synthetic warehouse is reproducible from its generator. Publish these bulky
# runtime artifacts to S3 instead of storing hundreds of megabytes in Git.
data/xanhsm_mock_warehouse/csv/
data/xanhsm_mock_warehouse/xanhsm_mock_warehouse.sqlite

# --- Secrets / local env ---
*.env
.env
.envrc
kubeconfig
*.pem

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
.rendered/
.gstack/

# Extra secret patterns for bench/scripts/scan_secrets.sh. Local only: the whole point
# of that script is that the values it hunts for are never committed.
.secrets-extra
